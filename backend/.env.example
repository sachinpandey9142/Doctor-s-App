MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority&tls=true
MONGODB_DIRECT_URI=
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters_long
CLIENT_URL=https://your-frontend-domain.com
NODE_ENV=production

# Cloudinary — image uploads (get credentials from cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
