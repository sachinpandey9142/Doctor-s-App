# Doctor's App - Docker Compose Environment Configuration
# Copy this file to .env and update values as needed

# ========== Node Environment ==========
NODE_ENV=development

# ========== MongoDB Configuration ==========
# Default credentials - CHANGE THESE IN PRODUCTION
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=password

# ========== Backend Configuration ==========
# Backend port (inside container: 8080, exposed on: 8080)
BACKEND_PORT=8080

# JWT Secret - MUST change in production! Use a strong random string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production_12345

# Client URL - URL where frontend is running
CLIENT_URL=http://localhost:3000

# ========== Cloudinary Configuration (Optional) ==========
# For image/video uploads
# Get these from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ========== Mobile App Configuration ==========
# Backend API URL as seen from mobile app
REACT_APP_API_URL=http://backend:8080/api

# Expo Debug mode
EXPO_DEBUG=false

# ========== Optional: Expo Tunnel Mode ==========
# Uncomment this to use Expo Tunnel instead of LAN mode
# EXPO_TUNNEL=true
