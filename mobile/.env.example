# Mobile App Environment Example
# Copy this file to .env or .env.development and modify it as needed.
# These variables start with EXPO_PUBLIC_ so they are accessible to the app.

# Explicitly override the backend API URL. 
# If this is not set, the app will auto-detect the dev server IP (via expo-constants) or fallback to 10.0.2.2/localhost.
# Useful for pointing to a remote backend or explicit local network IP if auto-detection fails.
# EXPO_PUBLIC_API_BASE_URL=http://10.65.248.205:8080/api

# WebSocket URL
# EXPO_PUBLIC_SOCKET_URL=http://10.65.248.205:8080
